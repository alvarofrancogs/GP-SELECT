# GP SELECT: automatic HTTPS, the static web, and proxies to the API and to photo storage.
# The routing mirrors the build's preview rules (frontend/build/seoPlugin.ts).
{
	email {$ACME_EMAIL}
	{$CADDY_EXTRA_GLOBAL}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

{$DOMAIN} {
	import security
	encode zstd gzip
	root * /srv

	# Hashed build files never change; other assets can be replaced; pages are always revalidated.
	@hashed path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2)$
	@assets {
		path /assets/*
		not path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2)$
	}
	@pages not path /assets/* /api/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @assets Cache-Control "public, max-age=604800"
	header @pages Cache-Control "no-cache"

	# Public page variants go straight to their canonical URL; vehicle slug case is preserved.
	map {path} {canonical} {
		~(?i)^/index\.html/?$ /
		~(?i)^/vehiculos(?:/index\.html)?/?$ /vehiculos
		~(?i)^/importacion(?:/index\.html)?/?$ /importacion
		~(?i)^/nosotros(?:/index\.html)?/?$ /nosotros
		~(?i)^/contacto(?:/index\.html)?/?$ /contacto
		~(?i)^/aviso-legal(?:/index\.html)?/?$ /aviso-legal
		~(?i)^/privacidad(?:/index\.html)?/?$ /privacidad
		~(?i)^/cookies(?:/index\.html)?/?$ /cookies
		~(?i)^/vehiculos/([a-z0-9-]+)(?:/index\.html)?/?$ /vehiculos/${1}
		# English (frontend/src/i18n/routes.ts).
		~(?i)^/en(?:/index\.html)?/?$ /en
		~(?i)^/en/vehicles(?:/index\.html)?/?$ /en/vehicles
		~(?i)^/en/import(?:/index\.html)?/?$ /en/import
		~(?i)^/en/about(?:/index\.html)?/?$ /en/about
		~(?i)^/en/contact(?:/index\.html)?/?$ /en/contact
		~(?i)^/en/legal-notice(?:/index\.html)?/?$ /en/legal-notice
		~(?i)^/en/privacy(?:/index\.html)?/?$ /en/privacy
		~(?i)^/en/cookies(?:/index\.html)?/?$ /en/cookies
		~(?i)^/en/vehicles/([a-z0-9-]+)(?:/index\.html)?/?$ /en/vehicles/${1}
		default {path}
	}
	@needsRedirect expression `{canonical} != {path}`
	redir @needsRedirect {canonical}{?query} 301

	handle /api/* {
		reverse_proxy api:8080
	}

	@servicios path /servicios /servicios/
	handle @servicios {
		redir * /importacion{?query} 308
	}

	@admin path /admin /admin/*
	handle @admin {
		rewrite * /admin/index.html
		file_server
	}

	# Live catalogue links, retaining the build's static page on API failure.
	handle /vehiculos {
		reverse_proxy api:8080 {
			rewrite /seo/vehiculos
			@unavailable status 404 5xx
			handle_response @unavailable {
				rewrite * /vehiculos/index.html
				file_server {
					status 200
				}
			}
		}
	}

	# SEO-2: the API fills each vehicle page's metadata (SeoController). If it fails, the plain SPA loads the vehicle itself,
	# answered as 503: without the API nobody can tell whether the vehicle exists, so crawlers must neither index nor drop it.
	@vehicle path_regexp vehicle (?i)^/vehiculos/([^/]+)/?$
	handle @vehicle {
		reverse_proxy api:8080 {
			rewrite /seo/vehiculos/{re.vehicle.1}
			@unavailable status 5xx
			handle_response @unavailable {
				header Retry-After 300
				rewrite * /spa.html
				file_server {
					status 503
				}
			}
		}
	}

	handle /en/vehicles {
		reverse_proxy api:8080 {
			rewrite /seo/en/vehicles
			@unavailable status 404 5xx
			handle_response @unavailable {
				rewrite * /en/vehicles/index.html
				file_server {
					status 200
				}
			}
		}
	}

	@vehicle_en path_regexp vehicle_en (?i)^/en/vehicles/([^/]+)/?$
	handle @vehicle_en {
		reverse_proxy api:8080 {
			rewrite /seo/en/vehicles/{re.vehicle_en.1}
			@unavailable status 5xx
			handle_response @unavailable {
				header Retry-After 300
				rewrite * /en/spa.html
				file_server {
					status 503
				}
			}
		}
	}

	# The live sitemap comes from the inventory; the build's static one covers an API failure.
	handle /sitemap.xml {
		reverse_proxy api:8080 {
			rewrite /seo/sitemap.xml
			@unavailable status 404 5xx
			handle_response @unavailable {
				file_server
			}
		}
	}

	handle {
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors {
		@catalogue_down {
			path /vehiculos
			expression {err.status_code} >= 500
		}
		handle @catalogue_down {
			rewrite * /vehiculos/index.html
			file_server {
				status 200
			}
		}
		# The API is down (the proxy could not reach it): vehicle pages still work as the plain SPA, again as a 503.
		@vehicle_down {
			path_regexp (?i)^/vehiculos/[^/]+/?$
			expression {err.status_code} >= 500
		}
		handle @vehicle_down {
			header Retry-After 300
			rewrite * /spa.html
			file_server {
				status 503
			}
		}
		@catalogue_en_down {
			path /en/vehicles
			expression {err.status_code} >= 500
		}
		handle @catalogue_en_down {
			rewrite * /en/vehicles/index.html
			file_server {
				status 200
			}
		}
		@vehicle_en_down {
			path_regexp (?i)^/en/vehicles/[^/]+/?$
			expression {err.status_code} >= 500
		}
		handle @vehicle_en_down {
			header Retry-After 300
			rewrite * /en/spa.html
			file_server {
				status 503
			}
		}
		# Same for the sitemap: the build's static copy.
		@sitemap_down {
			path /sitemap.xml
			expression {err.status_code} >= 500
		}
		handle @sitemap_down {
			file_server {
				status 200
			}
		}
		@missing_en {
			path /en /en/*
			expression {err.status_code} == 404
		}
		handle @missing_en {
			rewrite * /en/404.html
			file_server
		}
		@missing expression {err.status_code} == 404
		handle @missing {
			rewrite * /404.html
			file_server
		}
	}
}

# Secondary domains keep paths and query strings, with automatic HTTPS for each name.
{$REDIRECT_DOMAINS} {
	redir https://{$DOMAIN}{uri} 308
}

# Self-hosted photo storage (SeaweedFS): the admin's browser uploads originals here with URLs signed by the API.
{$S3_SITE} {
	import security
	request_body {
		max_size 25MB
	}
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin "https://{$DOMAIN}"
		header Access-Control-Allow-Methods "PUT"
		header Access-Control-Allow-Headers "Content-Type"
		header Access-Control-Max-Age "3600"
		respond 204
	}
	handle {
		header >Access-Control-Allow-Origin "https://{$DOMAIN}"
		reverse_proxy seaweedfs:8333
	}
}

# Internal only (not published): the API reads the page template for vehicle pages from here.
http://:8080 {
	root * /srv
	@template path /spa.html /vehiculos/index.html /en/spa.html /en/vehicles/index.html
	handle @template {
		file_server
	}
	respond 404
}
