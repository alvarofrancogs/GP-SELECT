# Copy to .env (same folder) and fill in. Never commit .env.

# Public domain of the site (DNS A record to the server).
DOMAIN=gpselect.es
# Optional secondary names, comma-separated; each needs a DNS A record to this server.
# REDIRECT_DOMAINS=
# Email for Let's Encrypt (certificate expiry notices).
ACME_EMAIL=

# Long random passwords (for example: openssl rand -base64 32 | tr -d '/+=').
DB_PASSWORD=

# Photo storage (S3-compatible). Option A, self-hosted on this server (SeaweedFS): keep these four lines,
# give S3_DOMAIN its own DNS A record to the server, and set random keys below.
COMPOSE_PROFILES=self-hosted-storage
S3_DOMAIN=s3.gpselect.es
S3_ENDPOINT=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT=https://s3.gpselect.es
# Option B, an external provider (Cloudflare R2, Backblaze B2…): remove the four lines above, set S3_ENDPOINT to the
# provider's endpoint, create the bucket and its keys there, and allow PUT from https://DOMAIN in the bucket's CORS.
S3_BUCKET=gpselect
S3_ACCESS_KEY=
S3_SECRET_KEY=

# The only administrator. The hash is generated as described in docs/BACKEND-SETUP.md (never the plain password).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Contact form: keep false until the legal data, the email provider and the mailbox are ready.
ENQUIRIES_ENABLED=false
ENQUIRIES_NOTIFICATION_EMAIL=
# SMTP provider settings; port defaults to 587, security to StartTls (or SslOnConnect, usually port 465).
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_SECURITY=
# Database retention defaults to 30 days (minimum 1).
# ENQUIRIES_RETENTION_DAYS=

BACKUP_KEEP_DAYS=14

# Optional off-site backups: append ,offsite-backup to COMPOSE_PROFILES (or use it alone with external photos).
# Use a SEPARATE R2 bucket and credentials limited to that bucket. Provider defaults to Cloudflare.
# RCLONE_CONFIG_OFFSITE_PROVIDER=
# RCLONE_CONFIG_OFFSITE_ENDPOINT=
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# OFFSITE_BUCKET=
# Remote database retention defaults to 30 days. Photo history is retained until manually removed.
# OFFSITE_KEEP_DAYS=

# Only for a local test with self-signed certificates: CADDY_EXTRA_GLOBAL=local_certs
CADDY_EXTRA_GLOBAL=
# Host ports (change only for a local test).
HTTP_PORT=80
HTTPS_PORT=443
